# Configuração do ambiente - copie para .env e preencha
ANTHROPIC_API_KEY=sua_chave_aqui

# Auth — OBRIGATÓRIO em produção (assina os JWT). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Servidor
# PORT é injetada pela plataforma em produção (Railway); local usa 8000.
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Fila — se RabbitMQ não estiver acessível, os jobs rodam in-process (só com
# EMBEDDED_WORKER=true; sem fila durável).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# true = worker no mesmo processo do FastAPI. false = worker é serviço separado
# (exige REDIS_URL, senão API e worker não compartilham os jobs).
EMBEDDED_WORKER=true

# Job store compartilhado. Vazio = em memória (processo único).
# Obrigatório quando o worker roda em serviço próprio.
REDIS_URL=

# MCP server
# Vazio = subprocesso stdio dentro do próprio processo (dev).
# Definido = serviço MCP próprio via HTTP.
MCP_URL=
# Usados só pelo serviço MCP. No Railway, a rede privada é IPv6: use MCP_HOST=::
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_TRANSPORT=stdio

# CORS — origens do frontend quando ele tem domínio próprio (lista por vírgula).
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# ── Frontend (build-time, lido pelo Vite) ────────────────────────────────────
# Vazio = mesma origem. Definido = API em domínio próprio.
# Embutido no bundle: mudar exige rebuild do serviço de frontend.
VITE_API_URL=
