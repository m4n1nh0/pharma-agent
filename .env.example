# Configuração do ambiente - copie para .env e preencha
ANTHROPIC_API_KEY=sua_chave_aqui

# Auth — OBRIGATÓRIO em produção (assina os JWT). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave

# Servidor
# PORT é injetada pela plataforma em produção (Railway); local usa 8000.
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Fila — se RabbitMQ não estiver acessível, os jobs rodam in-process no worker embutido.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# true = worker no mesmo processo do FastAPI (obrigatório com job store em memória)
EMBEDDED_WORKER=true

# MCP Server
MCP_PHARMA_COMMAND=python
MCP_PHARMA_ARGS=mcp_server/pharma_tools.py

# Logging
LOG_LEVEL=INFO
