# Serviço: worker de análises assíncronas.
# Mesmo código da API, entrypoint diferente — consome as filas do RabbitMQ e
# escreve progresso/resultado no Redis, de onde a API lê.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY pyproject.toml .

RUN useradd -m pharma && chown -R pharma:pharma /app
USER pharma

# Não expõe porta: não recebe tráfego HTTP, só consome fila.
# Por isso este serviço NÃO pode dormir (scale-to-zero) — sem request para
# acordá-lo, as mensagens ficariam paradas na fila.
CMD ["python", "-m", "src.presentation.worker.consumer"]
